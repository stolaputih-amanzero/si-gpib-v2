{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build --webpack && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "cross-env NODE_ENV=production node dist/server.cjs",
    "clean": "rm -rf dist .next",
    "lint": "next lint",
    "pre-deploy-check": "tsx scripts/pre-deploy-check.ts",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=\"Mobile Chrome (Android mid-range)\"",
    "test:e2e:offline": "playwright test tests/e2e/offline/",
    "lighthouse:ci": "lhci autorun",
    "prepare": "husky",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@google/genai": "^2.4.0",
